<Window x:Class="SecureIQ_Africa.Quiz"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SecureIQ_Africa"
        mc:Ignorable="d"
        Title="SecureIQ Africa - Quiz" Height="550" Width="800"
        WindowStartupLocation="CenterScreen">

    <Grid Background="#FF0A1A3A">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#FF040237" Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Viewbox Grid.Column="0" Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Center" Height="70" Margin="0,0,10,0">
                    <TextBlock xml:space="preserve" FontFamily="Consolas" FontSize="7.5" Foreground="#FFAFAEB1" FontWeight="Bold" TextAlignment="Left" VerticalAlignment="Center" HorizontalAlignment="Left" TextWrapping="NoWrap">
█████████                                                  █████    ██████         █████████      ██████             ███                    
 ███░░░░░███                                                ░░███   ███░░░░███      ███░░░░░███    ███░░███           ░░░                     
░███    ░░░   ██████   ██████  █████ ████ ████████   ██████  ░███  ███    ░░███    ░███    ░███   ░███ ░░░  ████████  ████   ██████   ██████  
░░█████████  ███░░███ ███░░███░░███ ░███ ░░███░░███ ███░░███ ░███ ░███     ░███    ░███████████  ███████   ░░███░░███░░███  ███░░███ ░░░░░███ 
 ░░░░░░░░███░███████ ░███ ░░░  ░███ ░███  ░███ ░░░ ░███████  ░███ ░███   ██░███    ░███░░░░░███ ░░░███░     ░███ ░░░  ░███ ░███ ░░░   ███████ 
 ███    ░███░███░░░  ░███  ███ ░███ ░███  ░███     ░███░░░   ░███ ░░███ ░░████     ░███    ░███   ░███      ░███      ░███ ░███  ███ ███░░███ 
░░█████████ ░░██████ ░░██████  ░░████████ █████    ░░██████  █████ ░░░██████░██    █████   █████  █████     █████     █████░░██████ ░░████████
 ░░░░░░░░░   ░░░░░░   ░░░░░░    ░░░░░░░░ ░░░░░      ░░░░░░  ░░░░░    ░░░░░░ ░░    ░░░░░   ░░░░░  ░░░░░     ░░░░░     ░░░░░  ░░░░░░   ░░░░░░░░
                    </TextBlock>
                </Viewbox>

                <StackPanel Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="Quiz..." FontSize="28" FontWeight="Bold" Foreground="White"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
                        <TextBlock x:Name="ScoreTextBlock" Text="Score: 0" FontSize="18" FontWeight="Bold" Foreground="#FFAFAEB1" Margin="0,0,20,0"/>
                        <TextBlock x:Name="ProgressTextBlock" Text="Question 1 of 10" FontSize="18" FontWeight="Bold" Foreground="#FFAFAEB1"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- QUESTION AREA -->
        <Border Grid.Row="1" Background="#FF0A2A5A" Margin="30,20,30,20" CornerRadius="12">
            <Grid Margin="30,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="QuestionTextBlock" Grid.Row="0" Text="Loading question..." FontSize="16" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" Margin="0,0,0,20"/>

                <StackPanel x:Name="OptionsPanel" Grid.Row="1" Margin="0,10,0,10"/>

                <StackPanel Grid.Row="3" Orientation="Vertical" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <TextBlock x:Name="FeedbackTextBlock" Text="" FontSize="18" FontWeight="Bold" Foreground="White" TextAlignment="Center" Margin="0,10,0,10"/>
                    <Button x:Name="NextButton" Content="Next Question →" FontSize="18" FontWeight="Bold" Height="45" Width="200" Background="#FF040237" Foreground="White" Cursor="Hand" Visibility="Collapsed" Click="NextButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#FF040237"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FF0A2D5C"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- FOOTER -->
        <Border Grid.Row="2" Background="#FF040237" Padding="15">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="EnterButton"
                        Content="Enter"
                        FontSize="14"
                        FontWeight="Bold"
                        Height="30"
                        Width="80"
                        Background="#FF0A2D5C"
                        Foreground="White"
                        Cursor="Hand"
                        Margin="0,0,15,0"
                        Click="EnterButton_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#FF0A2D5C"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FF1A3D6C"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- NEW Previous Button -->
                <Button x:Name="PreviousButton"
                        Content="Previous"
                        FontSize="14"
                        FontWeight="Bold"
                        Height="30"
                        Width="80"
                        Background="#FF0A2D5C"
                        Foreground="White"
                        Cursor="Hand"
                        Margin="0,0,15,0"
                        Click="PreviousButton_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#FF0A2D5C"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FF1A3D6C"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button x:Name="FooterNextButton"
                        Content="Next"
                        FontSize="14"
                        FontWeight="Bold"
                        Height="30"
                        Width="80"
                        Background="#FF0A2D5C"
                        Foreground="White"
                        Cursor="Hand"
                        Click="NextButton_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#FF0A2D5C"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FF1A3D6C"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>