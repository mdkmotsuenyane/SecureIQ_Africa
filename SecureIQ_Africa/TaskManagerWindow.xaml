<Window x:Class="SecureIQ_Africa.TaskManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SecureIQ_Africa"
        mc:Ignorable="d"
        Title="SecureIQ | Task Manager"
        Height="620" Width="830"
        WindowStartupLocation="CenterScreen"
        Background="#FF0A1A3A"
        FontFamily="Segoe UI, sans-serif" Icon="/icon.png">

    <Window.Resources>
        <!-- TextBox Style with Focus (pure border change – no blur) -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FF040237"/>
            <Setter Property="Foreground" Value="#FFF0F4F8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#FF0A2D5C"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="CaretBrush" Value="#FF3B82F6"/>
            <Setter Property="SelectionBrush" Value="#FF3B82F6"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#FF3B82F6"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- ASCII Logo -->
            <RowDefinition Height="*"/>
            <!-- Task List -->
            <RowDefinition Height="Auto"/>
            <!-- Input Area -->
        </Grid.RowDefinitions>

        <!-- ===== SECUREIQ ASCII LOGO HEADER ===== -->
        <Border Grid.Row="0"
                Background="#FF040237"
                CornerRadius="10"
                Padding="15,10"
                Margin="0,0,0,15"
                BorderBrush="#FF0A2D5C"
                BorderThickness="1">
            <Viewbox Stretch="Uniform" 
                     HorizontalAlignment="Stretch" 
                     VerticalAlignment="Center" 
                     Height="75">
                <TextBlock xml:space="preserve" 
                           FontFamily="Consolas" 
                           FontSize="7.5" 
                           Foreground="#FFAFAEB1" 
                           FontWeight="Bold" 
                           TextAlignment="Left" 
                           TextWrapping="NoWrap">
█████████                                                  █████    ██████         █████████      ██████             ███                    
 ███░░░░░███                                                ░░███   ███░░░░███      ███░░░░░███    ███░░███           ░░░                     
░███    ░░░   ██████   ██████  █████ ████ ████████   ██████  ░███  ███    ░░███    ░███    ░███   ░███ ░░░  ████████  ████   ██████   ██████  
░░█████████  ███░░███ ███░░███░░███ ░███ ░░███░░███ ███░░███ ░███ ░███     ░███    ░███████████  ███████   ░░███░░███░░███  ███░░███ ░░░░░███ 
 ░░░░░░░░███░███████ ░███ ░░░  ░███ ░███  ░███ ░░░ ░███████  ░███ ░███   ██░███    ░███░░░░░███ ░░░███░     ░███ ░░░  ░███ ░███ ░░░   ███████ 
 ███    ░███░███░░░  ░███  ███ ░███ ░███  ░███     ░███░░░   ░███ ░░███ ░░████     ░███    ░███   ░███      ░███      ░███ ░███  ███ ███░░███ 
░░█████████ ░░██████ ░░██████  ░░████████ █████    ░░██████  █████ ░░░██████░██    █████   █████  █████     █████     █████░░██████ ░░████████
 ░░░░░░░░░   ░░░░░░   ░░░░░░    ░░░░░░░░ ░░░░░      ░░░░░░  ░░░░░    ░░░░░░ ░░    ░░░░░   ░░░░░  ░░░░░     ░░░░░     ░░░░░  ░░░░░░   ░░░░░░░░
                </TextBlock>
            </Viewbox>
        </Border>

        <!-- ===== TASK LIST PANEL ===== -->
        <Border Grid.Row="1"
                Background="#FF040237"
                CornerRadius="10"
                Padding="12"
                Margin="0,0,0,15"
                BorderBrush="#FF0A2D5C"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Stats Bar with Task Manager Title -->
                <Border Grid.Row="0"
                        Background="#FF0A1A3A"
                        CornerRadius="6"
                        Padding="12,8"
                        Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📋 Task Manager" 
                                   Foreground="White" 
                                   FontWeight="Bold" 
                                   FontSize="16" 
                                   Margin="0,0,25,0"/>
                        <TextBlock Text="Active:" 
                                   Foreground="#FFAFAEB1" 
                                   FontSize="13" 
                                   Margin="0,0,6,0"/>
                        <TextBlock x:Name="TaskCount"
                                   Text="0"
                                   Foreground="#FFF0F4F8"
                                   FontWeight="Bold"
                                   FontSize="13"
                                   Margin="0,0,20,0"/>
                        <TextBlock Text="Done:"
                                   Foreground="#FFAFAEB1"
                                   FontSize="13"
                                   Margin="0,0,6,0"/>
                        <TextBlock x:Name="CompletedCount"
                                   Text="0"
                                   Foreground="#FF34D399"
                                   FontWeight="Bold"
                                   FontSize="13"/>
                    </StackPanel>
                </Border>

                <!-- ListView -->
                <ListView x:Name="TaskListView"
                          Grid.Row="1"
                          Background="Transparent"
                          BorderThickness="0"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          FontSize="14"
                          Foreground="#FFE5E9F0"
                          ItemsSource="{Binding Tasks}">

                    <ListView.Resources>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Margin" Value="0,0,0,4"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        </Style>
                    </ListView.Resources>

                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <!-- Task Card -->
                            <Border Background="#FF0A1A3A"
                                    CornerRadius="8"
                                    Padding="12,8"
                                    BorderBrush="#FF0A2D5C"
                                    BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- SecureIQ Styled Checkbox -->
                                    <CheckBox Grid.Column="0"
                                              IsChecked="{Binding IsCompleted}"
                                              VerticalAlignment="Center"
                                              Margin="0,0,14,0"
                                              Foreground="#FF34D399"
                                              Click="CheckBox_Click">
                                        <CheckBox.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="4"/>
                                            </Style>
                                        </CheckBox.Resources>
                                    </CheckBox>

                                    <!-- Task Title -->
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Title}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#FFE5E9F0"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                        <Setter Property="Foreground" Value="#FF6B7280"/>
                                                        <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <!-- Delete Button -->
                                    <Button Grid.Column="2"
                                            Content="✕"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Foreground="#FFEF4444"
                                            FontSize="16"
                                            Cursor="Hand"
                                            Click="DeleteTask_Click"
                                            Tag="{Binding}"
                                            Margin="10,0,0,0">
                                        <Button.Resources>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="Foreground" Value="#FFEF4444"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Foreground" Value="#FFF87171"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <!-- ===== INPUT AREA ===== -->
        <Border Grid.Row="2"
                Background="#FF040237"
                CornerRadius="10"
                Padding="12"
                BorderBrush="#FF0A2D5C"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- New Task TextBox -->
                <TextBox x:Name="NewTaskTextBox"
                         Grid.Column="0"
                         Background="#FF0A1A3A"
                         Foreground="#FFF0F4F8"
                         BorderBrush="#FF0A2D5C"
                         BorderThickness="1"
                         FontSize="14"
                         Padding="14,10"
                         Margin="0,0,12,0"
                         VerticalContentAlignment="Center"
                         KeyDown="NewTaskTextBox_KeyDown"
                         Text="Enter a new task..."/>

                <!-- SecureIQ Primary Action Button (Flat, no effects) -->
                <Button x:Name="AddTaskButton"
                        Grid.Column="1"
                        Content="+ Create"
                        Width="100"
                        Height="42"
                        Background="#FF3B82F6"
                        Foreground="White"
                        FontWeight="SemiBold"
                        FontSize="14"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="AddTaskButton_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                    <Button.Triggers>
                        <EventTrigger RoutedEvent="Button.MouseEnter">
                            <BeginStoryboard>
                                <Storyboard>
                                    <ColorAnimation Storyboard.TargetProperty="Background.Color"
                                                    To="#FF2563EB" Duration="0:0:0.1"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="Button.MouseLeave">
                            <BeginStoryboard>
                                <Storyboard>
                                    <ColorAnimation Storyboard.TargetProperty="Background.Color"
                                                    To="#FF3B82F6" Duration="0:0:0.1"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Button.Triggers>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>