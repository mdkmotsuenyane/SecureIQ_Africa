<Window x:Class="SecureIQ_Africa.SecureIQChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SecureIQ_Africa"
        mc:Ignorable="d"
        Title="SecureIQ_Africa" Height="700" Width="1200" Icon="/icon.png">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="60*"/>
            <ColumnDefinition Width="240*"/>
            <ColumnDefinition Width="900*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="15"/>
            <RowDefinition Height="120"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header with ASCII Art and Logo (unchanged) -->
        <Border Grid.Row="0" Background="#FF040237" Margin="10,10,1,10" Grid.ColumnSpan="3" Grid.RowSpan="2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="140"/>
                </Grid.ColumnDefinitions>

                <!-- Centered ASCII ART -->
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Hidden" 
                              MaxHeight="120" Margin="0,5,10,5" Grid.ColumnSpan="2">
                    <TextBlock xml:space="preserve" FontFamily="Consolas" FontSize="6" 
                               Foreground="#FFAFAEB1" FontWeight="Bold"
                               TextAlignment="Center" HorizontalAlignment="Center">
█████████                                                  █████    ██████         █████████      ██████             ███                    
 ███░░░░░███                                                ░░███   ███░░░░███      ███░░░░░███    ███░░███           ░░░                     
░███    ░░░   ██████   ██████  █████ ████ ████████   ██████  ░███  ███    ░░███    ░███    ░███   ░███ ░░░  ████████  ████   ██████   ██████  
░░█████████  ███░░███ ███░░███░░███ ░███ ░░███░░███ ███░░███ ░███ ░███     ░███    ░███████████  ███████   ░░███░░███░░███  ███░░███ ░░░░░███ 
 ░░░░░░░░███░███████ ░███ ░░░  ░███ ░███  ░███ ░░░ ░███████  ░███ ░███   ██░███    ░███░░░░░███ ░░░███░     ░███ ░░░  ░███ ░███ ░░░   ███████ 
 ███    ░███░███░░░  ░███  ███ ░███ ░███  ░███     ░███░░░   ░███ ░░███ ░░████     ░███    ░███   ░███      ░███      ░███ ░███  ███ ███░░███ 
░░█████████ ░░██████ ░░██████  ░░████████ █████    ░░██████  █████ ░░░██████░██    █████   █████  █████     █████     █████░░██████ ░░████████
 ░░░░░░░░░   ░░░░░░   ░░░░░░    ░░░░░░░░ ░░░░░      ░░░░░░  ░░░░░    ░░░░░░ ░░    ░░░░░   ░░░░░  ░░░░░     ░░░░░     ░░░░░  ░░░░░░   ░░░░░░░░
                    </TextBlock>
                </ScrollViewer>

                <!-- Circular Image -->
                <Border Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" 
                        Width="100" Height="100" CornerRadius="50" 
                        Background="#FF040237" BorderBrush="DarkGreen" BorderThickness="3">
                    <Border.Clip>
                        <EllipseGeometry Center="50,50" RadiusX="50" RadiusY="50"/>
                    </Border.Clip>
                    <Image Source="/Ceo.jpg" Width="100" Height="100" 
                           Stretch="UniformToFill"/>
                </Border>
            </Grid>
        </Border>

        <!-- Chat ScrollViewer -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Background="#FF011E90" Grid.ColumnSpan="3">
            <StackPanel x:Name="ChatPanel" Margin="10"/>
        </ScrollViewer>

        <!-- Input Area -->
        <Grid Grid.Row="3" Margin="10,10,1,20" Grid.ColumnSpan="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- TextBox -->
            <TextBox x:Name="userInput" FontSize="14" Background="#FFD6D6D6" 
                     Margin="0,0,15,0" 
                     Height="60" TextWrapping="Wrap" 
                     Padding="8,5,8,5" MinHeight="60"
                     Foreground="Black" CaretBrush="White"
                     VerticalAlignment="Center" BorderBrush="#FF5D5D5D"/>

            <!-- OVAL BUTTON - Fixed version -->
            <Button Grid.Column="1" Content="Send" Width="130" Height="55"
                    HorizontalAlignment="Center" 
                    FontSize="20" FontWeight="Bold"
                    Background="#FF040163" BorderThickness="3"
                    Margin="0,5,0,5" Click="Button_Click">
                <Button.Foreground>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <GradientStop Color="Black" Offset="0"/>
                        <GradientStop Color="White" Offset="1"/>
                    </LinearGradientBrush>
                </Button.Foreground>
                <Button.BorderBrush>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <GradientStop Color="Black" Offset="0"/>
                        <GradientStop Color="White" Offset="1"/>
                    </LinearGradientBrush>
                </Button.BorderBrush>
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="27.5">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
                <Button.Triggers>
                    <EventTrigger RoutedEvent="Button.MouseEnter">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Width" To="140" Duration="0:0:0.1"/>
                                <DoubleAnimation Storyboard.TargetProperty="Height" To="60" Duration="0:0:0.1"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                    <EventTrigger RoutedEvent="Button.MouseLeave">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Width" To="130" Duration="0:0:0.1"/>
                                <DoubleAnimation Storyboard.TargetProperty="Height" To="55" Duration="0:0:0.1"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Button.Triggers>
            </Button>
        </Grid>
    </Grid>
</Window>